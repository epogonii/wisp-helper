# SPDX-License-Identifier: GPL-2.0-or-later

[Unit]
Description=Wisp helper for snapper
Documentation=https://github.com/epogonii/wisp-helper

[Service]
Type=dbus
BusName=io.github.epogonii.WispHelper
ExecStart=@libexecdir@/wisp-helper
RuntimeDirectory=wisp-helper
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
PrivateMounts=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
# SIGTERM goes to the helper alone, which lets a running snapper or btrfs
# finish first. undochange over many files takes long.
KillMode=mixed
TimeoutStopSec=30min
# ProtectSystem, ProtectHome, PrivateTmp, ProtectKernelModules (it hides
# /usr/lib/modules), RestrictSUIDSGID and PrivateDevices break undochange
# or the swap rollback.
